# Local config. THIS FILE IS TRACKED BY GIT.
#
# Put your real key on the GROQ_API_KEY line below, then run once:
#     git update-index --skip-worktree .env
# so your key is never staged. Without that, `git add -A` will commit it.
#
# To edit the tracked template again (e.g. to change the model):
#     git update-index --no-skip-worktree .env

# https://console.groq.com/keys
GROQ_API_KEY=

# Must emit JSON directly; reasoning models fail instructor's JSON mode.
GROQ_MODEL=openai/gpt-oss-120b

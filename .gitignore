# Secrets — never commit
.env
*.env
!.env.example
*.pem
*.key

# Confidential client material — synthetic fixtures are safe to commit, real
# QREs are not.
fixtures/real-qre/

# Ground truth. Synthetic is independently human-reviewed evaluation material
# and must be committed so evaluation is reproducible. Client-derived ground
# truth is confidential and must never be committed.
data/**
!data/**/
!data/**/.gitkeep
!data/ground_truth/Synthetic/**
data/ground_truth/Client/**
!data/ground_truth/Client/.gitkeep
# Test design inputs are project facts a person supplies, not generated output.
!data/inputs/test_design/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db

# Word lock files
~$*
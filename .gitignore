# Secrets — never commit
# .env IS tracked, but only ever with a blank GROQ_API_KEY. Your real key lives
# in your local copy, which is held back by:
#     git update-index --skip-worktree .env
# Run that once after cloning. See README "Setup".
.env.*
!.env.example
*.pem
*.key

# Confidential client material — synthetic fixtures are safe to commit, real
# QREs are not.
fixtures/real-qre/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store

# Generated artifacts are committed deliberately: they are the worked example a
# reviewer compares against, and Stage 5's audit reads them. They regenerate on
# every run, so expect churn.

# Word lock files
~$*

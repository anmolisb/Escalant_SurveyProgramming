<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d3" for="node" attr.name="defined_in_source" attr.type="boolean"/>
<key id="d2" for="node" attr.name="disposition_kind" attr.type="string"/>
<key id="d1" for="node" attr.name="terminal" attr.type="boolean"/>
<key id="d0" for="node" attr.name="kind" attr.type="string"/>
<graph edgedefault="directed"><node id="__START__">
  <data key="d0">start</data>
</node>
<node id="COMPLETE">
  <data key="d0">disposition</data>
  <data key="d1">True</data>
  <data key="d2">complete</data>
  <data key="d3">True</data>
</node>
<node id="SO1 to SO4 (screen-outs)">
  <data key="d0">disposition</data>
  <data key="d1">True</data>
  <data key="d2">screenout</data>
  <data key="d3">True</data>
</node>
<node id="SO5 (quota full)">
  <data key="d0">disposition</data>
  <data key="d1">True</data>
  <data key="d2">quota_full</data>
  <data key="d3">True</data>
</node>
</graph></graphml>
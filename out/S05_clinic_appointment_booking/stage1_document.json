        "is_bold": false,
        "heading_level": null
      },
      {
        "kind": "paragraph",
        "order": 16,
        "text": "Record expected and observed destination for every routing transition.",
        "style": "List Bullet",
        "is_bold": false,
        "heading_level": null
      },
      {
        "kind": "paragraph",
        "order": 17,
        "text": "Reject mutually exclusive selections and invalid numeric/text responses before progression.",
        "style": "List Bullet",
        "is_bold": false,
        "heading_level": null
      },
      {
        "kind": "paragraph",
        "order": 18,
        "text": "Produce an audit record containing inputs, timestamps, route, assertions, screenshots on failure and final disposition.",

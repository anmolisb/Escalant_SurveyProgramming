        "blocks": [
          {
            "kind": "paragraph",
            "order": 14,
            "text": "QUOTA_REGION: soft quota on D1: North=20%, South=20%, East=20%, West=20%, Central=20%",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 15,
            "text": "Quota-full respondents terminate at TERM_QUOTA_FULL before the next substantive question. Quota status must be logged.",
            "style": "Normal",
            "is_bold": false,
            "heading_level": null
          }
        ]

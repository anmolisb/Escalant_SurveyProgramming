        "target": "Study specification",
        "heading_text": "Study specification",
        "heading_order": 3,
        "heading_level": 1,
        "matched_by": "direct",
        "blocks": [
          {
            "kind": "paragraph",
            "order": 4,
            "text": "Business objective: Identify drivers of satisfaction, problems, loyalty and switching risk among mobile subscribers.",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 5,
            "text": "Target population: Adults 18-80 who recently used mobile network services and influenced the choice",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 6,
            "text": "Mode: Self-completion web survey",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 7,
            "text": "Estimated length: 7 minutes",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 8,
            "text": "General instruction: All questions are mandatory unless explicitly marked optional. Do not infer unstated routing.",
            "style": "Normal",
            "is_bold": true,
            "heading_level": null
          }
        ]
      },
      {
        "target": "Programming and QA requirements",
        "heading_text": "Programming and QA requirements",
        "heading_order": 16,
        "heading_level": 1,
        "matched_by": "direct",
        "blocks": [
          {
            "kind": "paragraph",
            "order": 17,
            "text": "Store stable question, option, route and test-run identifiers.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 18,
            "text": "Capture displayed random order for every randomized item.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 19,
            "text": "Record expected and observed destination for every routing transition.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 20,
            "text": "Reject mutually exclusive selections and invalid numeric/text responses before progression.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 21,
            "text": "Produce an audit record containing inputs, timestamps, route, assertions, screenshots on failure and final disposition.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          },
          {
            "kind": "paragraph",
            "order": 22,
            "text": "Do not send synthetic test responses into live operational reporting.",
            "style": "List Bullet",
            "is_bold": false,
            "heading_level": null
          }
        ]
      }

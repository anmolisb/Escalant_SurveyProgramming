  "routing": [
    {
      "rule": "R1",
      "condition": "S1 == 'No'",
      "action": "terminate",
      "destination": "TERM_INELIGIBLE"
    },
    {
      "rule": "R2",
      "condition": "S2 == 'No'",
      "action": "terminate",
      "destination": "TERM_INELIGIBLE"
    },
    {
      "rule": "R3",
      "condition": "S3 < 18 or S3 > 80",
      "action": "reject",
      "destination": "S3"
    },
    {
      "rule": "R4",
      "condition": "Q7 contains any problem",
      "action": "show",
      "destination": "Q8"
    },
    {
      "rule": "R5",
      "condition": "Q7 contains any problem",
      "action": "show",
      "destination": "Q9"
    },
    {
      "rule": "R6",
      "condition": "Q7 == ['None of these']",
      "action": "skip",
      "destination": "Q11"
    },
    {
      "rule": "R7",
      "condition": "Q9 in ['Yes, fully','Yes, partly']",
      "action": "show",
      "destination": "Q10"
    },
    {
      "rule": "R8",
      "condition": "Q9 == 'No'",
      "action": "skip",
      "destination": "Q11"
    },
    {
      "rule": "R9",
      "condition": "Q7 includes 'None of these' plus another option",
      "action": "reject",
      "destination": "Q7"
    }
  ],

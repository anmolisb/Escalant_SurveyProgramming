  "study": [
    "Business objective: Understand productivity, collaboration and friction in hybrid work.",
    "Target population: Adults 18-80 who recently used hybrid-work arrangements and influenced the choice",
    "Mode: Self-completion web survey",
    "Estimated length: 7 minutes",
    "General instruction: All questions are mandatory unless explicitly marked optional. Do not infer unstated routing."
  ],
  "programming": [
    "Store stable question, option, route and test-run identifiers.",
    "Capture displayed random order for every randomized item.",
    "Record expected and observed destination for every routing transition.",
    "Reject mutually exclusive selections and invalid numeric/text responses before progression.",
    "Produce an audit record containing inputs, timestamps, route, assertions, screenshots on failure and final disposition.",
    "Do not send synthetic test responses into live operational reporting."
  ],
  "quotas": [
    "QUOTA_REGION: soft quota on D1: North=20%, South=20%, East=20%, West=20%, Central=20%",

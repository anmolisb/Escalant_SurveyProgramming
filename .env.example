# Committed template. Copy to `.env` and fill in real values there.
# `.env` is gitignored — never put a real key in this file.
#
#   cp .env.example .env

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Must be a model that emits JSON directly. Reasoning models (qwen/qwen3.6-27b)
# fail instructor's JSON mode: they spend the token budget on thinking and
# return an empty completion.
GROQ_MODEL=openai/gpt-oss-120b

# Committed template. Copy to `.env` and fill in real values there.
# `.env` is gitignored — never put a real key in this file (CLAUDE.md §51, §53).
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider the agent's semantic steps call. "groq" | "none".
# "none" disables all LLM calls; the pipeline still runs and flags anything it
# cannot resolve deterministically.
LLM_PROVIDER=groq

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model for classification calls. Run scripts/benchmark_section_classifier.py
# to compare what your account has access to.
GROQ_MODEL=qwen/qwen3.6-27b

# Request timeout in seconds, and retry count for transient failures.
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
